# Copy this file to .env, then replace the database placeholders.
# Never commit .env or put real credentials in this template.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
database.default.hostname = 127.0.0.1
database.default.database = mira_plastik
database.default.username = USER_DATABASE
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306
